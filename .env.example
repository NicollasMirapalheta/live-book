# Configuração do backend (Fase 2A — persistência).
#
# Copie este arquivo para `.env` e preencha com os valores do SEU projeto Supabase.
# O `.env` é gitignored — nunca é commitado.
#
# Sem VITE_SUPABASE_URL, o app sobe no LocalAdapter (IndexedDB), offline (DATA-01 AC5).
#
# Painel do Supabase → Project Settings → API:
#   VITE_SUPABASE_URL      = a "Project URL" (ex.: https://xxxxxxxx.supabase.co)
#   VITE_SUPABASE_ANON_KEY = a "Publishable key" (sb_publishable_...), a chave PÚBLICA.
#                            NUNCA use a Secret key / service_role (ignora a RLS).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
